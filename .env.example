# ARETE environment example. Copy to .env.local and fill in.
# Placeholders only. Never commit real values.

# ---------------------------------------------------------------------------
# App mode
# ---------------------------------------------------------------------------
# demo -> deterministic in-memory data, one fixed account, no credentials.
#         Writes work and last until the server restarts; the UI says so.
# live -> Supabase for authentication and Postgres for data. Needs all three
#         variables below; ARETE refuses to start half-configured rather than
#         serving demo data as if it were the account.
NEXT_PUBLIC_APP_MODE=demo

# Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Live mode (leave blank in demo mode)
# ---------------------------------------------------------------------------
# Supabase, used for authentication only. The anon key is a public value: it
# identifies the project, it does not grant access. Row-level security does.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Request-scoped Postgres connection for the repository. Use the pooler URL
# with a role that row-level security APPLIES to. A service-role connection
# here would bypass every policy, and environment validation rejects one.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployment only — never used on the request path, never sent to the browser
# ---------------------------------------------------------------------------
# Service-role connection string. Bypasses row-level security, which is why it
# belongs to `npm run db:migrate` and `npm run db:seed` and nothing else.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# off -> events are typed and emitted to a no-op sink. Default and only
#        supported value until a provider is chosen and the user opts in.
NEXT_PUBLIC_ANALYTICS_SINK=off
