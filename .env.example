# ARETE environment example. Copy to .env.local and fill in.
# Placeholders only. Never commit real values.

# ---------------------------------------------------------------------------
# App mode
# ---------------------------------------------------------------------------
# demo  -> deterministic in-memory data. No credentials needed. Default.
# live  -> backed by Supabase. NOT IMPLEMENTED YET (arrives in stage 4:
#          "Data model, authentication, and reliable persistence").
#          Setting this to `live` today fails validation on purpose rather
#          than silently falling back to demo data.
NEXT_PUBLIC_APP_MODE=demo

# Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (stage 4 onward; leave blank in demo mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefixed with NEXT_PUBLIC_. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# off -> events are typed and emitted to a no-op sink. Default and only
#        supported value until a provider is chosen and the user opts in.
NEXT_PUBLIC_ANALYTICS_SINK=off
